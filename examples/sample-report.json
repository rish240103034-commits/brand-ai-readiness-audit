      "confidence": "high",
      "kind": "defect",
      "evidence": "0 of 12 sampled pages contain JSON-LD, microdata, or RDFa.",
      "affected_pages": [],
      "suggested_action": {
        "summary": "Add schema.org JSON-LD to key templates: Organization + WebSite on the homepage, and the page-appropriate type (Product/Offer, Article, FAQPage, LocalBusiness, BreadcrumbList) elsewhere. This is the highest-leverage discoverability fix.",
        "priority": "high"
      },
      "details": {},
      "why": "With no machine-readable markup, an assistant must infer every fact (who the brand is, what it sells, prices, dates) from prose — error-prone and rarely quoted with confidence.",
      "how_to_fix": "Add schema.org JSON-LD to key templates: Organization + WebSite on the homepage, and the page-appropriate type (Product/Offer, Article, FAQPage, Course, BreadcrumbList) elsewhere.",
      "scope": "0 of 12 pages",
      "measurements": {
        "pages_with_structured_data": 0,
        "pages": 12
      },
      "expected_impact": "Makes core facts directly quotable; typically the highest-leverage discoverability fix.",
      "impact": 4,
      "priority": 1
    },
    {
